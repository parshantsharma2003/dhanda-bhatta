# ==============================================================================
# DHANDA BHATTA COMPANY - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env.local` for local development. Never commit `.env.local`.
# ==============================================================================

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=dhanda_bhatta

# Cloudinary Media Storage (Server-side media assets)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Better Auth Security & Session Management (Phase 6)
# Minimum 32-character high-entropy secret (generate with `openssl rand -base64 32`)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Initial Admin Provisioning (Optional: for scripts/create-admin.js)
ADMIN_PROVISION_EMAIL=
ADMIN_PROVISION_NAME=
ADMIN_PROVISION_PASSWORD=

# Public Canonical Site URL (e.g. https://dhandabhattacompany.com or https://preview.dhandabhattacompany.com)
SITE_URL=
NEXT_PUBLIC_SITE_URL=

# Privacy & Security Salts
# High-entropy random salt used to hash client IPs for privacy-preserving rate limiting and audit logs
RATE_LIMIT_SALT=

# Rate Limiting & Anti-Spam (Optional: for durable serverless rate limiting via Upstash Redis)
# If omitted or left blank, the application automatically uses a resilient in-memory sliding window limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Search Engine & Analytics Integrations (Optional)
# Google Search Console HTML verification meta token
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
