# ==============================================================================
# DHANDA BHATTA COMPANY — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env.local` for local development. NEVER commit `.env.local`.
# All values below are blank placeholders. Fill with actual credentials locally.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Required for persistent product catalogues, orders, customer enquiries, and admin authentication.
# Format (Production): mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
# Format (Local Dev):  mongodb://127.0.0.1:27017/dhanda_bhatta
MONGODB_URI=

# Target database name (Optional; defaults to 'dhanda_bhatta')
# Recommended: dhanda_bhatta (dev) | dhanda_bhatta_prod (production)
MONGODB_DB_NAME=

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SESSION MANAGEMENT (Better Auth)
# ------------------------------------------------------------------------------
# High-entropy secret used for signing session cookies, tokens, and 2FA secrets.
# Required in production. Minimum 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL for authentication endpoints and redirection callbacks.
# Dev: http://localhost:3000 | Production: https://dhandabhattacompany.com
BETTER_AUTH_URL=

# ------------------------------------------------------------------------------
# 3. CANONICAL APPLICATION URLS
# ------------------------------------------------------------------------------
# Canonical URL used for sitemap generation, Schema.org structured data, and server redirects.
SITE_URL=

# Client-accessible canonical site URL. Must match SITE_URL in production.
NEXT_PUBLIC_SITE_URL=

# ------------------------------------------------------------------------------
# 4. MEDIA ASSET STORAGE (Cloudinary)
# ------------------------------------------------------------------------------
# Required for admin photo/video uploads and signed Cloudinary transformations.
# Obtain from Cloudinary Console Dashboard (https://console.cloudinary.com/).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 5. PRIVACY & SECURITY SALTS
# ------------------------------------------------------------------------------
# High-entropy random salt used to hash client IPs for privacy-preserving rate limiting and audit logs.
# Generate with: openssl rand -hex 16
RATE_LIMIT_SALT=

# ------------------------------------------------------------------------------
# 6. INITIAL ADMIN BOOTSTRAP (Optional)
# ------------------------------------------------------------------------------
# Used only when running the CLI provisioning script: `npm run admin:create`
# If left blank, the script prompts for credentials interactively.
ADMIN_PROVISION_EMAIL=
ADMIN_PROVISION_NAME=
ADMIN_PROVISION_PASSWORD=

# ------------------------------------------------------------------------------
# 7. SEARCH ENGINE & ANALYTICS INTEGRATIONS (Optional)
# ------------------------------------------------------------------------------
# Google Search Console ownership verification token (HTML tag verification value).
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# 8. TEST RUNNER CONFIGURATION (Optional)
# ------------------------------------------------------------------------------
# Target base URL for test scripts (defaults to http://localhost:3000 if omitted).
TEST_BASE_URL=

# ------------------------------------------------------------------------------
# 9. DISTRIBUTED RATE LIMITING (Optional)
# ------------------------------------------------------------------------------
# Optional: For distributed multi-region rate limiting via Upstash Redis.
# If left blank, the application automatically uses its built-in in-memory sliding window limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
